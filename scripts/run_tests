#!/usr/bin/env bash

#
# Compile OPALX and run unit- and regression tests.
#

# exit on error
set -o errexit

declare -ri	EC_ARG_ERROR=1
declare -ri	EC_GIT_ERROR=10

declare branch="${OPALX_BRANCH:-master}"
declare regtests_branch="cleanup"
declare architecture="cpu-serial"

# indexed arrays
declare -a cmake_args=()
declare -a opalx_args=()
declare -a unittests_args=()

declare -r today=$(date +%Y-%m-%d)
declare -r time=$(date +%H-%M)
declare -r timestamp="${today}_${time}"

#------------------------------------------------------------------------------- 
# error handling
#
declare aborting='yes'

# SITINT or SIGTERM event calls _signal_handler
# exits the script with the errorcode 
trap _signal_handler SIGINT SIGTERM
_signal_handler() {
	local ec=$?
	echo "Aborting ..."
	aborting='yes'
	exit ${ec}
}

# EXIT event calls _exit
# if in aborting state exit the script with the errorcode 
trap _exit EXIT
_exit() {
        local -i ec=$?
	if [[ ${aborting} == 'yes' ]]; then
		return ${ec}
	fi
	update_overview
}

# if errorcode ($1) > 0, then redirect output to 
# stderr and exit the script with the errorcode
die() {
	(( $1 > 0 )) && exec 1>&2
	echo -e "$2\n"
	exit $1
}

usage() {
	echo "Usage:
	$(basename "$0") [OPTIONS...] 

Compile OPALX, run regression-tests. 
On the first time this script is called, the following steps will be
performed:

1. clone OPALX repository
2. compile OPALX, stop on error
3. clone regression-tests repository
4. run regression-tests

On further calls:

1. update OPAL repository
2. compile OPAL only if changed, stop on error
3. update regression-tests repository
4. run regression-tests only if OPAL has been compiled or the some 
    regression-tests has been changed.


OPTIONS:
===========
--publish-dir=DIR
	Prefix of the publication directory.
	If not set, defaults to /home/aliemen/opalx/nightly-results/
	If explicitly set to empty (e.g. --publish-dir=''), no HTML output will be created.

--use-slurm
	Run regression tests via salloc/srun (cluster mode). Default is local execution.

ENV:
====
OPALX_SRC_DIR
	Path to an existing OPALX source directory to compile from.
	If set, this is preferred over cloning into the workspace.

--config=FILE
	The options above can be defined in the configuration FILE.
	Configuration files can also set the 'architecture' variable
	(e.g., cpu-serial, cpu-openmp, gpu-cuda-a100) to organize
	builds and results by architecture.
	
--compile
	Compile OPAL even nothing changed and a binary exists.

--unit-tests
	Run unit-tests even OPAL has not been compiled.

--reg-tests
	Run regression-tests even OPAL has not been compiled and the
	tests has not been changed.

-f | --force
	Force compiling OPAL and run unit- and regression-tests.

-h | -? | --help
	This help.

" 1>&2
	exit 1
}

#-------------------------------------------------------------------------------
# handle arguments
#

# default URL for OPALX source and regression-tests repository
declare src_repo_url="https://github.com/OPALX-project/OPALX.git"
declare	tests_repo_url="https://github.com/OPALX-project/regression-tests-x.git"

# absolute or relative directory where to publish the results
# of the regression und unit tests. If empty, nothing will be
# published.
declare -x	publish_dir=''
declare     publish_dir_was_set='no'

# run unit- and/or regression tests
declare	opt_force='no'
declare	do_compile='no'
declare do_unittests='no'
declare do_regtests='no'
declare use_slurm='no'

# configuration file
declare	opt_config_file="default-${branch}.conf"

# tests to run, all if non passed as argument
declare -a tests=()

while (( $# > 0 )); do
	case $1 in
        --config|--config=* )
            if [[ $1 == *=* ]]; then
                opt_config_file="${1#*=}"
            else
                opt_config_file="$2"; shift 1
            fi
            if [[ ! -e "${opt_config_file}" ]]; then
                die 1 "ERROR: configuration file does not exist - ${opt_config_file}"
            fi
            source "${opt_config_file}"
            if (( $? != 0)); then
                die 1 "ERROR: cannot source configuration file - ${opt_config_file} "
            fi
            ;;
        --use-slurm )
            use_slurm='yes'
            ;;
		--publish-dir|--publish-dir=* )
             
            if [[ $1 == *=* ]]; then
                publish_dir="${1#*=}"
            else
                publish_dir="$2"; shift 1
            fi
            publish_dir_was_set='yes'
            if [[ -n ${publish_dir} ]]; then
                publish_dir=$(python3 -c "import os, sys; print(os.path.abspath(sys.argv[1]))" "${publish_dir}")
            fi
            ;;
		--compile )
			do_compile='yes'
			;;
        --reg-tests )
            do_regtests='yes'
            ;;
        --unit-tests )
            do_unittests='yes'
			;;
		-f | --force )
		    opt_force='yes'
			do_compile='yes'
            do_regtests='yes'
            do_unittests='yes'
		    ;;
		-h | -\? | --help )
			usage
			;;
		-* )
            echo "Unknown option: $1" 1>&2
            exit
            ;;
		* )
            tests+=( "$1" )
            ;;
	esac
	shift 1
done

# Default: always publish nightly results unless explicitly disabled.
# To disable publication, pass --publish-dir='' explicitly.
if [[ "${publish_dir_was_set}" != "yes" && -z "${publish_dir}" ]]; then
    publish_dir="/home/aliemen/opalx/nightly-results"
fi
if [[ -n "${publish_dir}" ]]; then
    publish_dir=$(python3 -c "import os, sys; print(os.path.abspath(sys.argv[1]))" "${publish_dir}")
    mkdir -p "${publish_dir}"
fi


#-------------------------------------------------------------------------------
# Directory layout
#
# ${PREFIX}/scripts					                        ${bindir}
# ${PREFIX}/workspace					                    ${workspace}
# ${PREFIX}/workspace/${branch}				                ${branchdir}
# ${PREFIX}/workspace/${branch}/src			                ${srcdir}
# ${PREFIX}/workspace/${branch}/${architecture}/build		${builddir}
# ${PREFIX}/workspace/${branch}/tests			            ${testsbase}
# ${PREFIX}/workspace/${branch}/tests/RegressionTests	    ${testsdir}

# Get absolute path to this script, portable handling for macOS/Linux
if [[ "$(uname)" == "Darwin" ]]; then
    declare -r abs_scriptname=$(python3 -c "import os, sys; print(os.path.abspath(sys.argv[1]))" "$0")
else
    declare -r abs_scriptname=$(readlink -f "$0")
fi

declare -r bindir="${abs_scriptname%/*}"
declare -r prefix="${bindir%/*}"
declare -r workspace="${prefix}/workspace"
declare -r branchdir="${workspace}/${branch}"
declare    srcdir="${branchdir}/src"
declare    builddir="${branchdir}/${architecture}/build"
declare -r testsbase="${branchdir}/tests"
declare -r testsdir="${testsbase}/RegressionTests"

# Prefer an existing local OPALX working directory when available.
# This lets the script compile from a local checkout (or an override)
# while still keeping build artifacts under ${workspace}/${branch}/...
declare -r local_opalx_src_sibling="${prefix%/*}/opalx"
declare -r local_opalx_src_home="${HOME}/opalx"
if [[ -n "${OPALX_SRC_DIR:-}" ]]; then
    if [[ -d "${OPALX_SRC_DIR}" ]]; then
        srcdir="${OPALX_SRC_DIR}"
    fi
elif [[ -d "${local_opalx_src_sibling}" ]]; then
    srcdir="${local_opalx_src_sibling}"
elif [[ -d "${local_opalx_src_home}" ]]; then
    srcdir="${local_opalx_src_home}"
fi

# Result variables
result_compile="-"

# Unit tests
result_u_total="-"
result_u_passed="-"
result_u_failed="-"
result_u_disabled="-"
result_u_broken="-"

# Regression tests
result_r_total="-"
result_r_passed="-"
result_r_failed="-"
result_r_disabled="-"
result_r_broken="-"

clone_repo() {
	local -r repo_url="$1"
	local -r dir="$2"
	{
		git clone "${repo_url}" "${dir}" || exit ${EC_GIT_ERROR}
		cd "${dir}"
		git checkout "${branch}" || exit ${EC_GIT_ERROR}
	}
}

update_repo() {
        # Variables (read-only) to hold the arguments
	local -r _dir="$1"
	local -r _branch="$2"
	local -r _url="$3"

        # Checks if the arguements are non-zero, exit the script if they are
	[[ -n "${_dir}" ]]    || die ${EC_ARG_ERROR} "Oops in $0: no repo dir passed!"
	[[ -n "${_branch}" ]] || die ${EC_ARG_ERROR} "Oops in $0: no branch name passed!"
	[[ -n "${_url}" ]]    || die ${EC_ARG_ERROR} "Oops in $0: no repo URL passed!"

        # Checks if the the directory does not exist, clones
	if [[ ! -d "${_dir}" ]]; then
		git clone "${_url}" "${_dir}"
		cd "${_dir}"
		git checkout "${_branch}"
        bash gen_OPALrevision
		return 0
        # Otherwise merge the changes 
	else
		cd "${_dir}"
		git rev-parse --is-inside-work-tree 1>/dev/null 2>&1 || \
			die ${EC_GIT_ERROR} "${_dir}: is not a Git working directory!"
		git checkout "${_branch}"
		git fetch

		local -i num_changed_files=$(git diff --name-only  "origin/${_branch}"  | wc -l | awk '{print $1}')
		if (( $num_changed_files == 0 )); then
			echo "Working directory '${_dir}' is up to date!"
			return 1
		fi
		git merge "origin/${_branch}"
        bash gen_OPALrevision
		return 0
	fi
}

compile_opalx() {
    result_compile='failed'
    mkdir -p "${branchdir}"
	cd "${branchdir}"
	rm -rf "${builddir}"
	mkdir -p "${builddir}"
	cd "${builddir}"
	cmake "${cmake_args[@]}" "${srcdir}"
	time make -j2
    result_compile='ok'
}

run_regressiontests() {
    # Python file to run tests
    local -r run_tests="${bindir}/run-reg-tests.py"

    # Array to hold arguments
    local opts=()

    # Create publishing directory
    if [[ -n "${publish_dir}" ]]; then
        local -r publish_regtests_dir="${publish_dir}/regressionTests/${branch}/${architecture}"
        mkdir -p "${publish_regtests_dir}"
        opts+=("--publish-dir=${publish_regtests_dir}")
    fi

    # Append the OPALX arguments to the array
	if [[ -n "${opalx_args}" ]]; then
		opts+=(${opalx_args[@]/#/--opalx-args=})
	fi
    opts+=("--opalx-exe-path=${builddir}/src")
	opts+=("--base-dir=${testsdir}")
    opts+=("--timestamp=${timestamp}")

    # Run regression tests (force unbuffered Python output so logs stream to the UI)
    if [[ "${use_slurm}" == "yes" ]]; then
	    salloc --gpus=1 --partition=gwendolen --cluster=gmerlin6  --account=gwendolen --nodes=1 --ntasks=1 --cpus-per-task=1 --time=02:00:00 \
            srun --pty python3 -u "${run_tests}" "${opts[@]}" "--" "${tests[@]}"
    else
        python3 -u "${run_tests}" "${opts[@]}" "--" "${tests[@]}"
    fi

    # Ensure existance of publishing directory
    local -i ec=$?
    [[ -n ${publish_dir} ]] || return ${ec}

    # compile the XML results file with the XSLT stylesheet
    local -r results_xml="${publish_regtests_dir}/results_${timestamp}.xml"
    local -r results_xslt="${publish_regtests_dir}/results.xslt"
    if [[ -f "${results_xml}" ]]; then
        local -r results_html="${results_xml%.*}.html"
        if [[ -f "${results_xslt}" && $(command -v xsltproc 2>/dev/null) ]]; then
            xsltproc "${results_xslt}" "${results_xml}" > "${results_html}" || true
        fi
        # Fallback: if xsltproc is not available or failed, generate a minimal HTML summary.
        if [[ ! -s "${results_html}" ]]; then
            python3 - <<'PY' "${results_xml}" "${results_html}"
import sys, xml.etree.ElementTree as ET

xml_path, html_path = sys.argv[1], sys.argv[2]
root = ET.parse(xml_path).getroot()

sims = root.findall("Simulation")
broken = sum(1 for s in sims for t in s.findall("Test") if t.findtext("state") == "broken")
failed = sum(1 for s in sims for t in s.findall("Test") if t.findtext("state") == "failed")
passed = sum(1 for s in sims for t in s.findall("Test") if t.findtext("state") == "passed")
total = sum(1 for s in sims for _ in s.findall("Test"))

with open(html_path, "w", encoding="utf-8") as f:
    f.write("<html><head><title>OPALX Regression Results (minimal)</title></head><body>\\n")
    f.write(f"<h1>OPALX Regression Results (minimal)</h1>\\n")
    f.write(f"<p>Passed: {passed} &nbsp; Broken: {broken} &nbsp; Failed: {failed} &nbsp; Total tests: {total}</p>\\n")
    f.write("<ul>\\n")
    for s in sims:
        name = s.get("name", "")
        descr = s.get("description", "")
        states = [t.findtext("state") or "-" for t in s.findall("Test")]
        f.write(f"<li><b>{name}</b> – {descr} (states: {', '.join(states)})</li>\\n")
    f.write("</ul>\\n</body></html>\\n")
PY
        fi
    fi

    # get results from HTML file created/updated by regression-tests 
    local index_html="${publish_regtests_dir}/index.html"
    read passed broken failed total < <(
            awk "/${timestamp}/ {
                    split(\$4, p, \":\");
                    split(\$6, b, \":\");
                    split(\$8, f, \":\");
                    split(\$10, t,  \":\");
                    printf \"%s %s %s %s\n\", p[2], b[2], f[2], t[2]; exit}" \
                            < "${index_html}")
    result_r_total=${total/\]}
    result_r_passed=${passed}
    result_r_failed=${failed}
    result_r_disabled='-'
    result_r_broken=${broken}

    return ${ec}
}

update_overview() {
    # nothing to do if ...
    [[ -n ${publish_dir} ]] || return 0
    [[ "${result_compile}${result_u_total}${result_r_total}" == '---' ]] && return 0

    # Create overview directory - separate from test results
    local -r overview_dir="${publish_dir}/overview/${branch}/${architecture}"
    mkdir -p "${overview_dir}"

    # org file with the table we have to update
    local -r index_org="${overview_dir}/index.org"

    # Always regenerate header from template to ensure placeholders are current
    # First, extract existing table data if the file exists
    local -r tmpfile=$(mktemp "/tmp/index_table.XXXXXX")
    if [[ -e "${index_org}" ]]; then
        # Extract only the table lines (starting from the date header)
        awk '/\|.*Date.*build.*unit-tests.*regression-tests/ {found=1} found {print}' "${index_org}" > "${tmpfile}"
    else
        # New file - create empty table
        echo '|       Date | build | unit-tests   | regression-tests   |' > "${tmpfile}"
        echo '|------------+-------+--------------+--------------------|' >> "${tmpfile}"
        echo '|            |       |              |                    |' >> "${tmpfile}"
    fi

    # Regenerate the full file from template with substitutions
    sed -e "s/@BRANCH@/${branch}/g" \
        -e "s/@ARCHITECTURE@/${architecture}/g" \
        "${bindir}/html/index.org" > "${index_org}"
    
    # Remove the template's empty table and append the actual table data
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' '/|.*Date.*build.*unit-tests.*regression-tests/,$ d' "${index_org}"
    else
        sed -i '/|.*Date.*build.*unit-tests.*regression-tests/,$ d' "${index_org}"
    fi
    cat "${tmpfile}" >> "${index_org}"
    rm -f "${tmpfile}"

    # links to generated XML pages used in the table
    # Adjusted relative paths from overview directory
    local -r u_results_html="../../../unitTests/${branch}/${architecture}/results_${timestamp}.html"
    local -r r_results_html="../../../regressionTests/${branch}/${architecture}/results_${timestamp}.html"

    local time_col
    local ofile="${publish_dir}/output/${branch}/${architecture}/${timestamp}.txt"
    if [[ -e "${ofile}" ]]; then
        time_col="[[../../../output/${branch}/${architecture}/${timestamp}.txt][${today} ${time/-/:}]]"
    else
        time_col="${today} ${time/-/:}"
    fi

    # build string with result for unit-tests. This will be used as link-name.
    if [[ "${result_u_total}" == "-" ]]; then
        local -r u_report='-'
    else
        local -r u_t="total:${result_u_total}"
        local -r u_p="passed:${result_u_passed}"
        local -r u_f="failed:${result_u_failed}"
        local -r u_d="disabled:${result_u_disabled}"
        local -r u_b="broken:${result_u_broken}"
        local -r u_report="[[${u_results_html}][${u_t}; ${u_p}; ${u_f}; ${u_d}; ${u_b}]]"
    fi
    # build string with result for regression-tests. This will be used as link-name.
    if [[ "${result_r_total}" == "-" ]]; then
        local -r r_report='-'
    else
        local -r r_t="total:${result_r_total}"
        local -r r_p="passed:${result_r_passed}"
        local -r r_f="failed:${result_r_failed}"
        local -r r_d="disabled:${result_r_disabled}"
        local -r r_b="broken:${result_r_broken}"
        local -r r_report="[[${r_results_html}][${r_t}, ${r_p}, ${r_f}, ${r_d}, ${r_b}]]"
    fi
    # add new line to org table
    line=""
    line+="| ${time_col} "
    line+="| ${result_compile} "
    line+="| ${u_report} "
    line+="| ${r_report} "
    line+="|"
    local -r tmpfile2=$(mktemp "/tmp/awk.XXXXXX")
    awk "{print}; /^\|-/ {print \"${line}\"}" \
        "${index_org}" > "${tmpfile}"
    mv "${tmpfile}" "${index_org}"

    # Remove #+SETUPFILE if present to avoid file read errors on local builds
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' '/^#+SETUPFILE/d' "${index_org}"
    else
        sed -i '/^#+SETUPFILE/d' "${index_org}"
    fi

    # Define the styles to embed
    local -r style_content="<style>
  $(cat ${bindir}/html/org-html-themes/src/readtheorg_theme/css/htmlize.css 2>/dev/null || echo '')
  $(cat ${bindir}/html/org-html-themes/src/readtheorg_theme/css/readtheorg.css 2>/dev/null || echo '')
</style>
<script type=\"text/javascript\">
  $(cat ${bindir}/html/org-html-themes/src/readtheorg_theme/js/readtheorg.js 2>/dev/null || echo '')
</script>"

    if command -v pandoc 1>/dev/null 2>&1; then
        pandoc -f org -t html \
            --metadata title="OPALX" \
            --include-in-header=<(echo "${style_content}") \
            -s -o "${index_org%.*}.html" "${index_org}"

        # Update master landing page with all architectures
        update_master_landing_page
    else
        echo "pandoc not found; skipping overview HTML generation."
    fi

    # Update top-level index with trigger form and per-branch links
    update_root_index
}

update_root_index() {
    # Regenerate the top-level index.html under the publish root.
    [[ -n ${publish_dir} ]] || return 0

    local -r root_dir="${publish_dir}"
    local -r root_index="${root_dir}/index.html"

    mkdir -p "${root_dir}"

    {
        echo '<!DOCTYPE html>'
        echo '<html lang="en">'
        echo '<head>'
        echo '  <meta charset="UTF-8" />'
        echo '  <title>OPALX Nightly Results</title>'
        echo '  <style>'
        echo '    :root { color-scheme: dark; }'
        echo '    * { box-sizing: border-box; margin: 0; padding: 0; }'
        echo '    body { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;'
        echo '           min-height: 100vh; padding: 2.5rem 1.5rem 3rem;'
        echo '           background: radial-gradient(circle at top, #1f2937 0, #020617 55%, #000 100%);'
        echo '           color: #e5e7eb; display: flex; justify-content: center; }'
        echo '    .page { width: 100%; max-width: 960px; }'
        echo '    .header { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 2.5rem; }'
        echo '    .title { font-size: 1.9rem; font-weight: 600; letter-spacing: 0.03em; }'
        echo '    .subtitle { font-size: 0.95rem; color: #9ca3af; max-width: 40rem; }'
        echo '    .grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1.4fr); gap: 1.5rem; align-items: flex-start; }'
        echo '    @media (max-width: 800px) { .grid { grid-template-columns: minmax(0, 1fr); } }'
        echo '    .card { background: rgba(15,23,42,0.96); border-radius: 0.9rem; padding: 1.75rem 1.8rem;'
        echo '            box-shadow: 0 22px 45px rgba(15,23,42,0.8); border: 1px solid rgba(148,163,184,0.25); }'
        echo '    .card h2 { font-size: 1.15rem; margin-bottom: 0.75rem; }'
        echo '    .card p.hint { font-size: 0.9rem; color: #9ca3af; margin-bottom: 1.1rem; }'
        echo '    label { display: block; text-align: left; font-size: 0.85rem; color: #9ca3af; margin-bottom: 0.35rem; }'
        echo '    input[type="text"] { width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.55rem;'
        echo '                         border: 1px solid rgba(148,163,184,0.6); background: rgba(15,23,42,0.8);'
        echo '                         color: #e5e7eb; font-size: 0.95rem; outline: none; }'
        echo '    input[type="text"]:focus { border-color: #38bdf8; box-shadow: 0 0 0 1px rgba(56,189,248,0.6); }'
        echo '    .button-row { margin-top: 1rem; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }'
        echo '    .primary-button { padding: 0.6rem 1.4rem; border-radius: 999px; border: none; cursor: pointer;'
        echo '                      font-size: 0.9rem; font-weight: 500; color: #0f172a;'
        echo '                      background: linear-gradient(135deg, #38bdf8, #22c55e);'
        echo '                      box-shadow: 0 14px 30px rgba(56,189,248,0.45); }'
        echo '    .primary-button:hover { filter: brightness(1.05); }'
        echo '    .secondary-button { padding: 0.55rem 1.2rem; border-radius: 999px; border: 1px solid rgba(148,163,184,0.7);'
        echo '                        cursor: pointer; font-size: 0.85rem; font-weight: 500;'
        echo '                        background: transparent; color: #e5e7eb; }'
        echo '    .secondary-button:hover { background: rgba(15,23,42,0.8); }'
        echo '    .button-hint { font-size: 0.8rem; color: #9ca3af; }'
        echo '    .branch-list { list-style: none; margin-top: 0.75rem; }'
        echo '    .branch-list li { margin: 0.25rem 0; }'
        echo '    .branch-list a { color: #38bdf8; text-decoration: none; font-size: 0.95rem; }'
        echo '    .branch-list a:hover { text-decoration: underline; }'
        echo '    @media (max-width: 480px) {'
        echo '      body { padding: 1.8rem 1.1rem 2.4rem; }'
        echo '      .title { font-size: 1.5rem; }'
        echo '      .card { padding: 1.4rem 1.4rem; }'
        echo '      .button-row { flex-direction: column; align-items: stretch; }'
        echo '      .primary-button,'
        echo '      .secondary-button { width: 100%; justify-content: center; text-align: center; }'
        echo '    }'
        echo '  </style>'
        echo '</head>'
        echo '<body>'
        echo '  <div class="page">'
        echo '    <header class="header">'
        echo '      <div class="title">OPALX Nightly Results</div>'
        echo '      <p class="subtitle">Trigger a protected nightly run and browse per-branch test overviews. The trigger endpoint is secured via HTTP basic authentication.</p>'
        echo '    </header>'
        echo '    <main class="grid">'
        echo '      <section class="card">'
        echo '        <h2>Trigger new run</h2>'
        echo '        <p class="hint">Submit a branch name to start a new nightly job. You will see a live status screen while it runs.</p>'
        echo '        <form method="POST" action="/trigger">'
        echo '          <label for="branch-input">Branch</label>'
        echo '          <input id="branch-input" type="text" name="branch" placeholder="e.g. master or feature/xyz" required />'
        echo '          <div class="button-row">'
        echo '            <button class="primary-button" type="submit">Start nightly run</button>'
        echo '            <button class="secondary-button" type="button" onclick="window.location.href='\''/trigger/status'\''">View current run status</button>'
        echo '            <span class="button-hint">Requires valid HTTP basic auth.</span>'
        echo '          </div>'
        echo '        </form>'
        echo '      </section>'
        echo '      <section class="card">'
        echo '        <h2>Available branches</h2>'
        echo '        <p class="hint">Browse historical overviews for each branch with compiled results.</p>'
        echo '        <ul class="branch-list">'

        if [[ -d "${root_dir}/overview" ]]; then
            local d branch_name
            for d in "${root_dir}/overview"/*; do
                [[ -d "${d}" ]] || continue
                branch_name=$(basename "${d}")
                [[ -f "${d}/index.html" ]] || continue
                printf '          <li><a href="overview/%s/index.html">%s</a></li>\n' "${branch_name}" "${branch_name}"
            done
        fi

        echo '        </ul>'
        echo '      </section>'
        echo '    </main>'
        echo '  </div>'
        echo '</body>'
        echo '</html>'
    } > "${root_index}"
}

update_master_landing_page() {
    if ! command -v pandoc 1>/dev/null 2>&1; then
        return 0
    fi

    # Master landing page location
    local -r master_dir="${publish_dir}/overview/${branch}"
    local -r master_org="${master_dir}/index.org"
    local -r master_html="${master_dir}/index.html"
    
    mkdir -p "${master_dir}"
    
    # Find all architecture directories under this branch
    local -a architectures=()
    if [[ -d "${publish_dir}/overview/${branch}" ]]; then
        while IFS= read -r arch_dir; do
            local arch_name=$(basename "${arch_dir}")
            # Skip files, only process directories
            [[ -d "${arch_dir}" ]] && [[ -f "${arch_dir}/index.html" ]] && architectures+=("${arch_name}")
        done < <(find "${publish_dir}/overview/${branch}" -maxdepth 1 -type d ! -path "${publish_dir}/overview/${branch}")
    fi
    
    # Build the master page from template
    local -r tmpfile=$(mktemp "/tmp/master-landing.XXXXXX")
    
    # Copy template and substitute @BRANCH@, stop at placeholder
    sed "s/@BRANCH@/${branch}/g" "${bindir}/html/master-index.org" | \
        awk '/ARCHITECTURE_LINKS will be inserted here/ {exit} {print}' > "${tmpfile}"
    
    # Add links for each architecture
    if (( ${#architectures[@]} > 0 )); then
        for arch in "${architectures[@]}"; do
            echo "" >> "${tmpfile}"
            echo "- [[./${arch}/index.html][${arch} Details]]" >> "${tmpfile}"
        done
    else
        echo "" >> "${tmpfile}"
        echo "No architectures available yet. Run tests to populate this page." >> "${tmpfile}"
    fi
    
    # Write the updated master page
    mv "${tmpfile}" "${master_org}"
    
    # Remove #+SETUPFILE if present to avoid file read errors on local builds
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' '/^#+SETUPFILE/d' "${master_org}"
    else
        sed -i '/^#+SETUPFILE/d' "${master_org}"
    fi
    
    # Convert to HTML
    local -r style_content="<style>
  $(cat ${bindir}/html/org-html-themes/src/readtheorg_theme/css/htmlize.css 2>/dev/null || echo '')
  $(cat ${bindir}/html/org-html-themes/src/readtheorg_theme/css/readtheorg.css 2>/dev/null || echo '')
</style>
<script type=\"text/javascript\">
  $(cat ${bindir}/html/org-html-themes/src/readtheorg_theme/js/readtheorg.js 2>/dev/null || echo '')
</script>"
    
    pandoc -f org -t html \
        --metadata title="OPALX Regression Tests" \
        --include-in-header=<(echo "${style_content}") \
        -s -o "${master_html}" "${master_org}"
}

main() {
    # local variable for the opalx binary
    local -r opalxbin="${builddir}/src/opalx"
    
    # Getting latest repo version
    printf "\nUpdating OPALX source repository... \n"
    if [[ -d "${srcdir}" ]]; then
        if git -C "${srcdir}" rev-parse --is-inside-work-tree 1>/dev/null 2>&1; then
            update_repo "${srcdir}" "${branch}" "${src_repo_url}" && do_compile='yes'
        else
            echo "Using local OPALX source (non-git): ${srcdir}"
            do_compile='yes'
        fi
    else
        update_repo "${srcdir}" "${branch}" "${src_repo_url}" && do_compile='yes'
    fi

    # If the binary does not exist we need to compile
    [[ -e ${opalxbin} ]] || do_compile='yes'
	aborting='no'
 
    # Compilation
	if [[ "${do_compile}" == "yes" ]]; then
        printf "\nStarting OPALX compilation \n"
		compile_opalx
		do_unittests='yes'
		do_regtests='yes'
	fi
    
    # Unit tests

    # Regression test
    printf "\nUpdating regression tests repository...\n"
	update_repo "${testsbase}" "${regtests_branch}" "${tests_repo_url}" && do_regtests='yes'

    if [[ ${do_regtests} == 'yes' ]]; then
        printf "\nRunning regression tests for OPALX\n"
        run_regressiontests || return 1
    fi

}

main
